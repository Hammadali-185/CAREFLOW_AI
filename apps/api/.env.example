# Local development defaults. Copy to apps/api/.env before starting the API or migrating.
# These values match docker-compose.yml and are not production credentials.

NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://careflow:careflow@127.0.0.1:5432/careflow?schema=public
CORS_ORIGIN=http://127.0.0.1:5173,http://localhost:5173
# Local CSRF key only. Generate a new random value before any shared or deployed environment.
CSRF_SECRET=local-development-csrf-secret-change-me
LOG_LEVEL=info
# Optional. Leave this unset to keep the API running; patients are sent to the booking form.
# MISTRAL_API_KEY=
MISTRAL_MODEL=ministral-3b-latest
MISTRAL_TIMEOUT_MS=20000
