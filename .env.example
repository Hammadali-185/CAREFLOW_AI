# Copy the API block to apps/api/.env and the web block to apps/web/.env.
# These are local placeholders. Do not put production passwords or provider keys here.

# apps/api/.env
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://careflow:careflow@127.0.0.1:5432/careflow?schema=public
CORS_ORIGIN=http://127.0.0.1:5173,http://localhost:5173
CSRF_SECRET=local-development-csrf-secret-change-me
LOG_LEVEL=info
# MISTRAL_API_KEY=
MISTRAL_MODEL=ministral-3b-latest
MISTRAL_TIMEOUT_MS=20000

# apps/web/.env
# Public API origin only. Never put database credentials or provider keys in the web file.
VITE_API_BASE_URL=http://127.0.0.1:4000
